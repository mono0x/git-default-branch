amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"

steps {
  ["cargo-fmt"] = Builtins.cargo_fmt
  ["dprint"] = (Builtins.dprint) {
    glob = "**/*.{json,jsonc,md,yaml,yml,toml}"
  }
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = Builtins.pkl_format
  ["jactionlint"] = new Step {
    glob =
      List(
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml",
        "**/action.yml",
        "**/action.yaml",
      )
    batch = true
    diagnostic_format = "sarif"
    check = new Config.CommandSpec {
      command = new Config.Command {
        argv = List("mise", "exec", "--", "jactionlint", "--format", "sarif", "{{files}}")
      }
      effect = "read"
    }
    check_diff = new Config.CommandSpec {
      command = new Config.Command {
        argv =
          List(
            "mise",
            "exec",
            "--",
            "hk",
            "util",
            "sarif-diff",
            "--",
            "jactionlint",
            "--format",
            "sarif",
            "{{files}}",
          )
      }
      effect = "read"
    }
    fix = new Config.CommandSpec {
      command = new Config.Command {
        argv = List("mise", "exec", "--", "jactionlint", "--fix", "{{files}}")
      }
      effect = "write"
    }
  }
}
